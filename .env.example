# Bearer token for /api/admin/* (Guy's Center console and scripts).
# In production, /center and /api/admin/* also sit behind their own
# Cloudflare Access application restricted to Guy's email — this token is
# the belt-and-suspenders check usable from scripts/tests.
ADMIN_API_TOKEN=

# Where pass/customer/session data is stored on disk.
DATA_DIR=./data

# Discovery Pass pricing (see lib/pricing.ts). Placeholders — Guy to
# confirm the real per-customer token budget cap and per-token cost from
# the Discovery Pass pricing sheet before go-live.
PASS_TOKEN_BUDGET=500000
PASS_COST_PER_TOKEN_USD=0.00002

# Interviewer agent model (lib/interviewer-llm.ts). DISCOVERY_AGENT_API_KEY
# is read under this name on purpose, never ANTHROPIC_API_KEY — that's the
# ambient name a Claude Max / Claude Code login or other Anthropic tooling
# would pick up automatically. The value here MUST be provisioned from
# O's prepaid, capped worker-engine credit pool (no card, no auto-reload) —
# never a Claude Max OAuth session, never any card-linked pay-as-you-go
# key. If unset, the interviewer runs on its deterministic offline engine
# instead of failing — see lib/interviewer.ts.
DISCOVERY_AGENT_API_KEY=
DISCOVERY_AGENT_MODEL=claude-haiku-4-5
